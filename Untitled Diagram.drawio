          </mxGeometry>
        </mxCell>
        <mxCell id="XzqHikHoQIbMlcwwCMR4-97" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;strong data-end=&quot;1928&quot; data-start=&quot;1897&quot;&gt;View Pending Space Requests&lt;/strong&gt;&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;3&quot;&gt;&amp;nbsp;The &lt;strong data-end=&quot;1956&quot; data-start=&quot;1935&quot;&gt;Registrar (Admin)&lt;/strong&gt; checks pending approvals.&lt;strong data-end=&quot;2014&quot; data-start=&quot;1988&quot;&gt;Review Request&amp;nbsp;&lt;/strong&gt;&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;3&quot;&gt;&lt;br&gt;&lt;strong data-end=&quot;2014&quot; data-start=&quot;1988&quot;&gt;&lt;/strong&gt;&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;3&quot;&gt;&lt;strong data-end=&quot;2014&quot; data-start=&quot;1988&quot;&gt;Details&lt;/strong&gt;&amp;nbsp;&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;3&quot;&gt;The system shows meeting details, including date, time, attendees, and purpose.&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;3&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;3&quot;&gt;&lt;strong data-end=&quot;2125&quot; data-start=&quot;2102&quot;&gt;Check for Conflicts&lt;/strong&gt;&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;3&quot;&gt;&lt;strong data-end=&quot;2125&quot; data-start=&quot;2102&quot;&gt;&lt;/strong&gt;The system ensures no double-booking or maintenance conflicts exist.&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;3&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;3&quot;&gt;&lt;strong data-end=&quot;2221&quot; data-start=&quot;2202&quot;&gt;Approve Request&lt;/strong&gt;&amp;nbsp;&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;3&quot;&gt;The shared space is assigned, and a confirmation email is sent to the requester and attendees.&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;3&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;3&quot;&gt;&lt;strong data-end=&quot;2354&quot; data-start=&quot;2324&quot;&gt;Reject Request (If Needed)&lt;/strong&gt;&lt;/font&gt;&lt;br&gt;&lt;font size=&quot;3&quot;&gt;The &lt;strong data-end=&quot;2382&quot; data-start=&quot;2361&quot;&gt;Registrar (Admin)&lt;/strong&gt; provides a reason for rejection, and the requester is notified.&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" parent="XzqHikHoQIbMlcwwCMR4-95" vertex="1">
